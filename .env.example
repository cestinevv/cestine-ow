# Production 环境配置

# API Gateway
VITE_API_BASE_URL=

# Solana / Chain（生产环境 Mainnet；RPC http/wss 一律走 Admin chainlinks）
VITE_CHAIN=
VITE_STORY_PROGRAM_ID=
# 支付币种（`getPaymentCurrencyFromEnv` / `PaymentCurrencyContext`）

# 创建短剧：封面 / 海报 objectKey 拼接公网访问根（部署时按实际上线桶或 CDN 修改）
VITE_MINI_DRAMA_ASSET_BASE_URL=

# Plato STORY 交易入口
VITE_PLATO_TRADE_URL=

# Privy Web3 Login
VITE_PRIVY_APP_ID=

# Centrifugo
VITE_CENTRIFUGO_WSS_BASE_URL=

# Privy Session Signer（后端代签）
VITE_PRIVY_SESSION_SIGNER_ID=
VITE_PRIVY_EVM_POLICY_ID=
VITE_PRIVY_SVM_POLICY_ID=
VITE_PRIVY_SUI_POLICY_ID=
VITE_PRIVY_TRON_POLICY_ID=

# Orval OpenAPI 文档地址（仅 development / testenv 配置；生产构建不远程拉取）

# ---------- 可观测性（本环境）----------
# VITE_* 会打进前端包；SENTRY_* 仅构建机读取，不会进浏览器包。
# 生产必须保留有效 DSN；SENTRY_UPLOAD 生产保持 1，临时排障可改 0。

# 浏览器上报地址（Sentry Client Key / DSN）。有值才真正上报；注释或留空 =
VITE_SENTRY_DSN=

# 应用版本号 / Sentry release。须与 Source Map 上传的 release 一致。Docker/CI 用 GIT_COMMIT 注入，一般不必在本文件写死。
# VITE_APP_VERSION=

# 构建期是否上传 Source Map（scripts/vite.sentry.ts）：0=
SENTRY_UPLOAD=

# 构建上传用的 Organization Auth Token（不是 DSN）。过期只影响传 map，不影响网站运行与构建成功。
SENTRY_AUTH_TOKEN=

# Sentry Organization slug（上传 Source Map 时告诉插件传到哪个组织）。
SENTRY_ORG=

# Sentry Project slug（上传 Source Map 时告诉插件传到哪个项目；与 DSN 对应项目应一致）。
SENTRY_PROJECT=
